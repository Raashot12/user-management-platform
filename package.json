{
  "name": "user-management-platform",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @ump/web dev",
    "dev:api": "pnpm --filter @ump/api start:dev",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @ump/api migration:run",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.8.3"
  }
}
